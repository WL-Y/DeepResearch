# LLM 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek-V4.1-Flash 的官方 API 模型 ID
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=0
# 单次输入字符及输出 token 上限；截断响应不作为有效结果，不自动重试。
LLM_MAX_INPUT_CHARS=70000
LLM_MAX_OUTPUT_TOKENS=5000
REPORT_MAX_OUTPUT_TOKENS=12000
# 报告独立输入上限；实际材料还受剩余 token 预算、提示词及输出预留约束。
REPORT_MAX_INPUT_CHARS=180000
REPORT_TIMEOUT_SECONDS=180
# 仅对 api.deepseek.com 发送该参数，默认关闭额外思考输出。
DEEPSEEK_THINKING=false
# 仅启用思考时发送：low / high / max；关闭时不发送以避免重新启用思考。
DEEPSEEK_REASONING_EFFORT=high
RESEARCH_TOKEN_BUDGET=1500000
RESEARCH_MAX_MODEL_CALLS=200
REPORT_TOKEN_BUDGET=100000
# 正常一次写作，只有输出截断才允许一次续写。材料整理不调用模型。
REPORT_MAX_MODEL_CALLS=2
# 混合调度：独立子任务最多并行 2 个，依赖任务等待前置发现。限流明显时设为 1。
RESEARCH_TASK_CONCURRENCY=2

# 搜索引擎配置（多引擎用逗号分隔，如：duckduckgo,tavily）
SEARCH_ENGINES=duckduckgo,tavily
SEARCH_API=duckduckgo
# 主渠道全部无结果/失败后按顺序切换，成功即停。公开网页渠道无需 API 密钥。
# brave_web 是 Brave 网页搜索，不是需要密钥的 Brave Search API。
SEARCH_FALLBACK_ENGINES=yahoo,brave_web,google,mojeek,startpage
SEARCH_FALLBACK_MAX_PROVIDERS=5
SEARCH_WEB_TIMEOUT_SECONDS=10
# 仅网络错误/超时重试一次；限流、拒绝访问直接冷却并换渠道。
SEARCH_WEB_RETRIES=1
# 全部为空时最多一个本地简化查询，在最多两个返回空结果的渠道上尝试。
SEARCH_QUERY_RELAXATION=true

# Tavily API Key（使用 Tavily 搜索时需要）
TAVILY_API_KEY=your_tavily_key_here

# 学术渠道：auto 按查询路由，web 只用通用渠道，academic 强制加入学术渠道。
SEARCH_PROFILE=auto
ACADEMIC_SEARCH_ENGINES=arxiv,openalex
ARXIV_READ_TIMEOUT_SECONDS=30
ACADEMIC_WEB_FALLBACK=true
# Semantic Scholar 默认停用，避免其限流影响检索。
# 两者支持无密钥基础请求，但可能限流，建议配置自己的密钥。
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_ENABLED=true
CROSSREF_MAILTO=
# 查询缓存：普通 1 天；“最新”等时效查询 1 小时；解析正文缓存 7 天。
# 不同查询复用正文下载，重新选取相关段落；设为 0 禁用正文缓存复用。
SEARCH_CACHE_TTL_SECONDS=86400
SEARCH_FRESH_CACHE_TTL_SECONDS=3600
SOURCE_CACHE_TTL_SECONDS=604800
SOURCE_MAX_BYTES=50000000
SOURCE_PDF_MAX_PAGES=500
SOURCE_MAX_EXTRACTED_CHARS=5000000
# 每次检索最多新增 8 份成功正文；最多尝试 16 个候选，每个最多 6 个公开地址。
# 全文按顺序分块分析；块大小只控制单次输入，不截掉后续内容。
SEARCH_READ_BUDGET=8
SEARCH_READ_ATTEMPTS=16
FULLTEXT_CHUNK_CHARS=20000
TAVILY_EXTRACT_FALLBACK=true
TAVILY_EXTRACT_MAX_URLS=5
# 每次 search_many 最多一次语义重排（新增模型费用），30 秒超时后回退。
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_CANDIDATES=16
# 每次最多扩展 1 篇论文、4 条一跳引文线索，候选仍须经过相关性筛选。
SEARCH_CITATION_EXPANSION=false
SEARCH_EXPANSION_SEEDS=1
SEARCH_EXPANSION_RESULTS=4

REPORT_MATERIALS_MAX_CHARS=160000

# 服务配置
HOST=0.0.0.0
PORT=8000

# PDF 中文字体：Windows 默认使用宋体；Linux 推荐指定允许嵌入的中文 TTF/TTC。
# 留空且未找到 Windows 字体时使用 PDF 标准中文字体，显示效果取决于阅读器。
EXPORT_FONT_PATH=

# 每任务先筛选再精读；选中的来源仍完整分块，未选中的正文缓存保留。
READING_OPTIMIZATION_ENABLED=true
ANALYSIS_SOURCE_LIMIT=4
ANALYSIS_PART_LIMIT=16
CONCEPT_SOURCE_LIMIT=2
CONCEPT_PART_LIMIT=8
